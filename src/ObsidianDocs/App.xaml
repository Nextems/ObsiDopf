<Application x:Class="ObsidianDocs.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ObsidianDocs"
             >
    <Application.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.ScrollBarBrushKey}" Color="#202027"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#25252D"/>
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DarkScrollThumb" TargetType="Thumb">
            <Setter Property="Background" Value="#57515F"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Handle" Background="{TemplateBinding Background}" CornerRadius="4" Margin="3"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="#7A688F"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="Background" Value="#A88ADB"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#202027"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Style="{StaticResource ScrollPageButton}" Command="{x:Static ScrollBar.PageUpCommand}"/></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb x:Name="Handle" Style="{StaticResource DarkScrollThumb}" MinHeight="48"/></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Style="{StaticResource ScrollPageButton}" Command="{x:Static ScrollBar.PageDownCommand}"/></Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="14"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <Setter TargetName="Handle" Property="MinHeight" Value="0"/><Setter TargetName="Handle" Property="MinWidth" Value="24"/>
                            <Setter TargetName="Decrease" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                            <Setter TargetName="Increase" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Application.Resources>
</Application>

