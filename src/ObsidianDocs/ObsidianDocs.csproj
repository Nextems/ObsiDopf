<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\ObsidianDocs.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyName>ObsiDopf</AssemblyName>
    <AssemblyTitle>ObsiDopf</AssemblyTitle>
    <RootNamespace>ObsidianDocs</RootNamespace>
    <Product>ObsiDopf</Product>
    <Description>PDF and DOCX viewer, comments, conversion and local OCR</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\ObsidianDocs.ico" />
    <Resource Include="Assets\ObsidianDocs.png" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFsharp-WPF" Version="6.2.3" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
  </ItemGroup>

</Project>
